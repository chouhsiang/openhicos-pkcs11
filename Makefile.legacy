# Legacy C build (optional). Prefer `make` for Rust build.

PREFIX  ?= /usr/local
OUT     ?= build
OBJDIR  ?= .obj
CC      ?= cc
CFLAGS  ?= -O2 -Wall -Wextra
LDFLAGS ?=

SRCS = pkcs11/module.c pkcs11/oh_pcsc.c pkcs11/oh_apdu.c \
	pkcs11/oh_der.c pkcs11/oh_sha.c pkcs11/oh_p15.c
OBJS = $(patsubst pkcs11/%.c,$(OBJDIR)/%.o,$(SRCS))

UNAME_S := $(shell uname -s)
UNAME_M := $(shell uname -m)
ifeq ($(UNAME_S),Darwin)
  OS_NAME := macos
  CFLAGS += -fPIC -fvisibility=hidden -Iinclude -Ipkcs11
  LDFLAGS += -framework PCSC -Wl,-exported_symbol,_C_GetFunctionList
  SHARED = -dynamiclib
  LIBNAME := openhicos-pkcs11-macos-$(UNAME_M).so
else
  OS_NAME := linux
  CFLAGS += -fPIC -fvisibility=hidden -Iinclude -Ipkcs11
  LDFLAGS += -lpcsclite
  SHARED = -shared
  LIBNAME := openhicos-pkcs11-linux-$(UNAME_M).so
endif

TARGET := $(OUT)/$(LIBNAME)

.PHONY: all clean

all: $(TARGET)

$(OUT) $(OBJDIR):
	mkdir -p $@

$(OBJDIR)/%.o: pkcs11/%.c | $(OBJDIR)
	$(CC) $(CFLAGS) -c -o $@ $<

$(TARGET): $(OBJS) | $(OUT)
	$(CC) $(SHARED) -o $@ $(OBJS) $(LDFLAGS)
	@echo "built $@ (legacy C)"

clean:
	rm -rf $(OUT) $(OBJDIR)
